# Secrets — never commit these
.env
.env.*
*.pem
*credentials*.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python / Node
__pycache__/
*.pyc
node_modules/

# Local env files (keep the template tracked)
.env.local
!.env.example

# Logs & local artifacts
*.log
npm-debug.log*

# Temporary test outputs
tmp/
.tmp/
test-output/
coverage/
*.tmp
