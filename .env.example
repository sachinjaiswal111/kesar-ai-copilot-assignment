# Local helper/test scripts ONLY (e.g. scripts/send_test_emails.py).
# Copy to .env and fill in. NEVER commit .env.
#
# n8n Cloud API keys (Gemini, Google Sheets OAuth) belong in n8n's
# Credentials Manager -- never in this file, in workflow nodes, or in Git.

# Test webhook (workflow open in the editor, "Listen for test event")
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook-test/kesar-support
# Production webhook (workflow activated)
N8N_WEBHOOK_PROD_URL=https://your-instance.app.n8n.cloud/webhook/kesar-support

# Optional, only for running LLM experiments locally:
# GEMINI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
